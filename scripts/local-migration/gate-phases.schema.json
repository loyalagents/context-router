{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-router.local/contracts/local-migration-gate-phases-v1.schema.json",
  "title": "Local Migration Baseline Gate phase lifecycle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "supportedModes", "phases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "supportedModes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/supportedMode" }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/phase" }
    }
  },
  "$defs": {
    "supportedMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "successorModes", "requiredEvidenceClasses"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "status": { "enum": ["active", "retired"] },
        "successorModes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        },
        "requiredEvidenceClasses": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceClass" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "active" } } },
          "then": { "properties": { "successorModes": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "status": { "const": "retired" } } },
          "then": { "properties": { "successorModes": { "type": "array", "minItems": 1, "maxItems": 1 } } }
        }
      ]
    },
    "evidenceClass": {
      "enum": ["contract", "documentation", "build", "state", "tooling", "evaluation", "research", "restart", "integrity"]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "ownerStep",
        "status",
        "timeoutMs",
        "modes",
        "evidenceClasses",
        "predecessors",
        "replacementEvidence",
        "retirementCondition",
        "kind",
        "commands"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "order": { "type": "integer", "minimum": 1 },
        "ownerStep": { "type": "string", "pattern": "^(0[1-9]|1[01])$" },
        "status": { "enum": ["active", "retired"] },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 1800000 },
        "terminationGraceMs": { "type": "integer", "minimum": 1, "maximum": 180000 },
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidenceClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceClass" }
        },
        "predecessors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
        },
        "replacementEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/replacementEvidence" }
        },
        "retirementCondition": { "type": "string", "minLength": 20 },
        "kind": { "enum": ["commands", "restart-smoke", "packaged-smoke"] },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/command" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "packaged-smoke" } } },
          "then": {
            "required": ["terminationGraceMs"],
            "properties": { "terminationGraceMs": { "const": 180000 } }
          },
          "else": { "not": { "required": ["terminationGraceMs"] } }
        },
        {
          "if": { "properties": { "status": { "const": "retired" } } },
          "then": {
            "properties": {
              "replacementEvidence": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    },
    "replacementEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "phaseId", "coveredModes", "evidenceClasses"],
          "properties": {
            "kind": { "const": "phase" },
            "phaseId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
            "coveredModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
            },
            "evidenceClasses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/evidenceClass" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path", "decisionId", "coveredModes", "evidenceClasses"],
          "properties": {
            "kind": { "const": "decision" },
            "path": { "type": "string", "minLength": 1 },
            "decisionId": { "type": "string", "pattern": "^LM-[0-9]{3}$" },
            "coveredModes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
            },
            "evidenceClasses": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/evidenceClass" }
            }
          }
        }
      ]
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
