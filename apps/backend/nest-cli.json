{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      {
        "include": "config/preferences.catalog.json",
        "outDir": "dist"
      }
    ]
  },
  "generateOptions": {
    "spec": false,
    "flat": false
  }
}
